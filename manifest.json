{
  // Comments are accepted in the manifest, even though it is JSON.
  "manifest_version": 3,
  "name": "tab-blocker",
  "description": "blocks errant tabs",
  "version": "0.0.1",
  "icons": {
    "16": "logo/logo-16.png",
    "48": "logo/logo-48.png",
    "128": "logo/logo-128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "tabs",
    "declarativeNetRequest",
    "commands"
  ],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {},
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle": {
      "suggested_key": "Ctrl+Shift+Y",
      "description": "Toggle Tab Blocker"
    }
  }
}
